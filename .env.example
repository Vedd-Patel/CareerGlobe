# Copy to .env and fill in. Never commit .env.

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=careerglobe
POSTGRES_PASSWORD=
POSTGRES_DB=careerglobe
POSTGRES_PORT=5433

# Main connection string (migrations, local dev)
DATABASE_URL=postgres://careerglobe:PASSWORD@127.0.0.1:5433/careerglobe?sslmode=disable
# Separate DB users on the server (spec: Security and operations)
CRAWLER_DATABASE_URL=
API_DATABASE_URL=
BACKUP_DATABASE_URL=

# --- Crawler ---
CRAWLER_USER_AGENT=CareerGlobeBot/0.1 (+https://github.com/Vedd-Patel/CareerGlobe)
CRAWLER_MIN_GAP_SECONDS=1.0
CRAWLER_MAX_GAP_SECONDS=2.0
CRAWLER_MAX_HOSTS_IN_FLIGHT=32
# Stop starting new companies at this IST time (HH:MM)
CRAWLER_STOP_AT_IST=05:30

# --- API ---
API_PORT=8080

# --- Firebase (Phase 3) ---
FIREBASE_PROJECT_ID=
# Path to the service-account JSON file, kept outside the repo
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated Firebase UIDs allowed into the admin console
ADMIN_FIREBASE_UIDS=

# --- Secrets (Phase 3–4) ---
# Server pepper for HMAC-SHA256 of access codes (32+ random bytes, base64)
ACCESS_CODE_PEPPER=
# AES-256-GCM key for resume files (32 random bytes, base64)
RESUME_ENCRYPTION_KEY=
RESUME_STORAGE_DIR=

# --- Backups to Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# age public key that backups are encrypted to
BACKUP_AGE_RECIPIENT=

# --- Heartbeat monitors (healthchecks.io ping URLs) ---
HEALTHCHECK_CRAWL_URL=
HEALTHCHECK_MATCH_URL=
HEALTHCHECK_BACKUP_URL=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
