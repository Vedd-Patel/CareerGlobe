{
  "name": "careerglobe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "api-types": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "dev": "npm run tokens && vite dev",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "maplibre-gl": "5.24.0"
  }
}
