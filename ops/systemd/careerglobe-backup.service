# Nightly encrypted backup to Cloudflare R2 (after matching, before the push).
[Unit]
Description=CareerGlobe backup to R2
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=careerglobe
Group=careerglobe
WorkingDirectory=/opt/careerglobe
ExecStart=/opt/careerglobe/ops/backup/backup.sh
TimeoutStartSec=2h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/careerglobe
